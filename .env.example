# -----------------------------------------------------------------------------
# GROWTHEDUH — environment variables
# Copy this file to `.env.local` for local development. Never commit .env.local.
# On Vercel, set the same variables in Project Settings > Environment Variables.
# -----------------------------------------------------------------------------

# Public URL of the site, without trailing slash. Used for canonical URLs,
# sitemap, Open Graph and share links.
#   local:      http://localhost:3000
#   production: https://www.your-domain.id
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Dashboard > Project Settings > API Keys).
# Both values are PUBLIC by design — data is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Use the "publishable" key (sb_publishable_...). Older projects can instead
# set NEXT_PUBLIC_SUPABASE_ANON_KEY with the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IMPORTANT: this app does NOT need the Supabase service_role / secret key.
# Do not add it here and never expose it to the browser.
